{
  "datasets": [
    {
      "name": "2e7d77f6",
      "displayName": "Monthly Total Paid: Senior vs Other Age Bands",
      "queryLines": [
        "SELECT \n",
        "  date_trunc('MONTH', `Service Month`) AS `month`,\n",
        "  CASE WHEN `Age Band` = 'Senior (65+)' THEN 'Senior (65+)' ELSE 'Other Age Bands' END AS `group`,\n",
        "  MEASURE(`Total Paid`) AS `total_paid`\n",
        "FROM `claims_metrics`\n",
        "WHERE `Age Band` IS NOT NULL\n",
        "GROUP BY ALL\n",
        "ORDER BY `month` ASC"
      ],
      "catalog": "madams",
      "schema": "data_mart"
    },
    {
      "name": "claims_mv",
      "displayName": "Claims Metrics",
      "asset_name": "claims_metrics",
      "catalog": "madams",
      "schema": "data_mart"
    }
